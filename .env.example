# Copy this file to .env and fill in values for local docker compose use.
# On Render, set the same vars in the dashboard Environment tab — never commit .env.

# ---- Required ----

# Postgres connection. For local docker-compose, leave commented — compose
# overrides DATABASE_URL to point at the bundled postgres service.
# For Render, use your Supabase pooler URL (port 5432, NOT 6543).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Flask session secret. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# REQUIRED on Render — server refuses to boot without it.
SECRET_KEY=change-me-to-a-long-random-string

# Admin user IDs (comma-separated integers). Admins see all shows across all
# users and can delete other users' shows. Leave blank for no admins.
# ADMIN_USER_IDS=2,3

# CORS origins for production (comma-separated). Only needed if your frontend
# is hosted somewhere other than the backend (e.g. separate domain). The
# default deployment serves the frontend from the same origin so this can be empty.
# ALLOWED_ORIGINS=https://my-frontend.example.com,https://www.example.com

# ---- Google OAuth (optional, but login won't work without it) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   http://localhost:5000/api/auth/google/callback   (local docker)
#   https://your-app.onrender.com/api/auth/google/callback   (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Cloudflare R2 (optional — if unset, videos save to local volume only) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fwp-videos
# R2_ENDPOINT_URL is auto-derived from R2_ACCOUNT_ID; only set to override.
# R2_ENDPOINT_URL=

# ---- YouTube downloads (optional) ----
# Base64-encoded Netscape-format cookies file. Without this, age-gated and
# bot-flagged videos will fail. Re-export every few weeks as cookies expire.
# To encode: base64 -i youtube_cookies.txt | tr -d '\n'
YOUTUBE_COOKIES=

# Proxy for YouTube downloads (optional). Datacenter IPs are blocked by YouTube,
# so this is required if running downloads from Render. Format examples:
#   http://user:pass@host:port
#   socks5://host:1080
# YOUTUBE_PROXY=

# Bright Data Unlocker API alternative (optional, alternative to YOUTUBE_PROXY).
# BRIGHT_DATA_UNLOCKER_API_KEY=
# BRIGHT_DATA_UNLOCKER_ZONE=

# ---- Local-client mode (only set if running the desktop downloader) ----
# LOCAL_DOWNLOADER_MODE=true
# REMOTE_SERVER_URL=https://your-app.onrender.com
