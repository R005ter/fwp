#!/bin/bash
set -e

case "$1" in
  purge|remove)
    rm -rf /opt/fwp-desktop/venv
    # Clean up the wheels and any leftover __pycache__ as well.
    rm -rf /opt/fwp-desktop/__pycache__
    if command -v update-desktop-database >/dev/null 2>&1; then
      update-desktop-database -q || true
    fi
    ;;
  upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;
esac

exit 0
